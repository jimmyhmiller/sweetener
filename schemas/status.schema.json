{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sweetener.local/schemas/status.schema.json",
  "title": "Sweetener project status",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "currentPhase",
    "currentSlice",
    "health",
    "summary",
    "currentTask",
    "tasks",
    "capabilities",
    "blockers",
    "nextTasks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "currentPhase": { "type": "string", "pattern": "^phase-[0-9]{2}$" },
    "currentSlice": { "type": "string", "minLength": 1 },
    "health": { "enum": ["green", "yellow", "red"] },
    "summary": { "type": "string", "minLength": 1 },
    "currentTask": { "type": ["string", "null"] },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "nextTasks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "phase",
        "status",
        "order",
        "owner",
        "branch",
        "prerequisites",
        "specifications",
        "nextAction"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "pattern": "^phase-[0-9]{2}$" },
        "status": {
          "enum": [
            "not-ready",
            "ready",
            "in-progress",
            "review",
            "blocked",
            "done",
            "superseded"
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "owner": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "specifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextAction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["pending", "in-progress", "done", "blocked"] }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": "object",
      "required": ["id", "title", "evidence", "requiredAction"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "evidence": { "type": "string" },
        "requiredAction": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
