import { thread } from "./declarative.sts" for syntax;

const map = <A, B>(values: readonly A[], fn: (value: A) => B): B[] =>
  values.map(fn);
const filter = <A>(
  values: readonly A[],
  predicate: (value: A) => boolean,
): A[] => values.filter(predicate);

export const result = thread(
  [1, 2, 3],
  map((value) => value + 1),
  filter((value) => value > 2),
);
