{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "recovered/**/*.sts",
    "recovered/**/*.stsx",
    "recovered/**/*.ts",
    "new/**/*.sts"
  ]
}
