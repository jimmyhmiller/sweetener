{
  "name": "@sweetener-example/vite-react",
  "private": true,
  "type": "module",
  "scripts": {
    "expand": "sweetener emit src/react-hooks.sts src/main.stsx --out-dir .sweetener",
    "lint:hooks": "pnpm expand && eslint --config eslint.expanded.config.mjs .sweetener/main.tsx",
    "check": "sweetener check --project sweetener.json && pnpm lint:hooks",
    "build": "pnpm check && vite build"
  },
  "dependencies": {
    "@sweetener/unplugin": "workspace:*",
    "@vitejs/plugin-react": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@sweetener/cli": "workspace:*",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.2"
  }
}
